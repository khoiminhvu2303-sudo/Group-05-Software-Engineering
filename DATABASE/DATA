Create Database LIBRARY MANAGEMENT SYSTEM;
Use LIBRARY MANAGEMENT SYSTEM;
Drop table if exists Reader;
Drop table if exists Publisher;
Drop table if exists Category;

Create table Category (
CategoryID Char(10) Primary Key NOT NULL,
CategoryName Varchar(50) NOT NULL,
BookID Char(10) 
);
Create table Publisher ( 
PublisherID Char(10) Primary Key NOT NULL,
Name Varchar(50) NOT NULL,
Address Varchar(50) NULL,
Phone Char(10) NULL,
Email Varchar(50) NULL,
Website Varchar(50) NULL,
CONSTRAINT UQ_Publisher_Name UNIQUE (Name),
CONSTRAINT UQ_Publisher_Address UNIQUE (Address),
CONSTRAINT UQ_Publisher_Phone UNIQUE (Phone),
CONSTRAINT UQ_Publisher_Email UNIQUE (Email),
CONSTRAINT UQ_Publisher_Website UNIQUE (Website)
);
Create table Reader ( 
ReaderID Char(10) Primary Key NOT NULL,
FullName varchar(50) NOT NULL,
DOB date NULL,
Phone Char(10) NULL,
Gender Char(10) NOT NULL,
Email varchar(50) NULL,
Address varchar(50) NULL,
CCCD char(12) NULL,
StartDate date NOT NULL,
ExpiryDate date NOT NULL,
Username varchar(50) NOT NULL,
Password varchar(50) NOT NULL,
Status Varchar(50) NOT NULL DEFAULT 'Active',
CONSTRAINT UQ_Reader_Phone UNIQUE (Phone),
CONSTRAINT UQ_Reader_Email UNIQUE (Email),
CONSTRAINT UQ_Reader_CCCD UNIQUE (CCCD),
CONSTRAINT UQ_Reader_Username UNIQUE (Username),
CONSTRAINT CHK_Reader_Status CHECK (Status IN ('Active', 'Locked', 'Suspended')),
CONSTRAINT CHK_Reader_Dates CHECK (ExpiryDate > StartDate)
);
