    <div className="flex h-screen overflow-hidden">
      {/* Sidebar */}
      <aside className="w-60 bg-[#0f172a] flex flex-col flex-shrink-0">
        <div className="p-5 border-b border-slate-800">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 bg-blue-600 rounded-lg flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </div>
            <div>
              <p className="text-white text-sm font-bold leading-tight">Thư Viện</p>
              <p className="text-slate-500 text-xs">Cổng thông tin</p>
            </div>
          </div>
        </div>
        <nav className="flex-1 p-3 space-y-0.5 overflow-y-auto">
          <p className="text-slate-600 text-xs font-semibold uppercase tracking-wider px-3 py-2 mt-2">Dịch vụ</p>
          <button onClick={() => setView("opac")} className={`sidebar-link w-full ${view === "opac" ? "active" : ""}`}>🔍 Tra cứu sách (OPAC)</button>
          {loggedIn && (
            <>
              <button onClick={() => setView("profile")} className={`sidebar-link w-full ${view === "profile" ? "active" : ""}`}>👤 Thông tin cá nhân</button>
              <button onClick={() => setView("history")} className={`sidebar-link w-full ${view === "history" ? "active" : ""}`}>📋 Lịch sử mượn trả</button>
              <button onClick={() => setView("wishlist")} className={`sidebar-link w-full ${view === "wishlist" ? "active" : ""}`}>❤️ Sách yêu thích</button>
            </>
          )}
          <p className="text-slate-600 text-xs font-semibold uppercase tracking-wider px-3 py-2 mt-3">Tài khoản</p>
          {!loggedIn ? (
            <>
              <button onClick={() => setView("login")} className={`sidebar-link w-full ${view === "login" ? "active" : ""}`}>🔐 Đăng nhập</button>
              <button onClick={() => setView("register")} className={`sidebar-link w-full ${view === "register" ? "active" : ""}`}>✏️ Đăng ký</button>
            </>
          ) : (
            <button onClick={() => { setLoggedIn(false); setView("opac"); }} className="sidebar-link w-full">🚪 Đăng xuất</button>
          )}
        </nav>
      </aside>

      {/* Main content */}
      <main className="flex-1 overflow-y-auto">
        {/* Top bar */}
        <div className="sticky top-0 z-10 bg-white border-b border-slate-200 px-6 py-3 flex items-center justify-between">
          <div className="flex items-center gap-2 text-sm text-slate-500">
            <span>Cổng thông tin Độc giả</span>
            <span>›</span>
            <span className="text-slate-800 font-medium">
              {view === "opac" ? "Tra cứu sách" : view === "login" ? "Đăng nhập" : view === "register" ? "Đăng ký" : view === "forgot" ? "Quên mật khẩu" : view === "profile" ? "Thông tin cá nhân" : view === "history" ? "Lịch sử mượn trả" : "Sách yêu thích"}
            </span>
          </div>
          {!loggedIn ? (
            <button className="btn-primary" style={{ padding: "8px 16px", fontSize: 13 }} onClick={() => setView("login")}>Đăng nhập</button>
          ) : (
            <div className="flex items-center gap-3">
              <div className="w-8 h-8 rounded-full bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center text-white text-xs font-bold">NA</div>
              <span className="text-sm font-medium text-slate-700">Nguyễn Thị An</span>
            </div>
          )}
        </div>

        <div className="p-6">
          {view === "opac" && <OPACSearch />}
          {(view === "login" || view === "register" || view === "forgot") && (
            <div>
              <AuthForm view={view} setView={(v) => {
                if (v === "profile") { setLoggedIn(true); setView("profile"); }
                else setView(v);
              }} />
              {view === "login" && (
                <div className="max-w-md mx-auto mt-4 p-4 bg-blue-50 border border-blue-200 rounded-lg text-sm text-blue-700">
                  <strong>Demo:</strong> Nhấn "Đăng nhập" để vào trang cá nhân
                </div>
              )}
            </div>
          )}
          {(view === "profile" || view === "history" || view === "wishlist") && loggedIn && <ReaderProfile />}
        </div>
      </main>
    </div>
  );
}

