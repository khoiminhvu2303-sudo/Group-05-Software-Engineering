            {/* BẢNG LỊCH SỬ MƯỢN SÁCH & GIA HẠN (ẢNH 3) */}
            <div className="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
              <div className="p-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <h3 className="font-bold text-slate-800 text-base">Lịch sử mượn sách & Sách đang mượn</h3>
                <span className="text-xs bg-slate-200 text-slate-700 px-3 py-1 rounded-full font-semibold">
                  {MOCK_BORROW_HISTORY.length} giao dịch
                </span>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full text-left text-xs border-collapse">
                  <thead>
                    <tr className="bg-slate-50 text-slate-400 font-bold uppercase tracking-wider border-b border-slate-200">
                      <th className="p-4">NHAN ĐỀ SÁCH</th>
                      <th className="p-4">NGÀY MƯỢN</th>
                      <th className="p-4">HẠN TRẢ</th>
                      <th className="p-4 text-center">GIA HẠN</th>
                      <th className="p-4">TRẠNG THÁI</th>
                      <th className="p-4 text-right">THAO TÁC</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100">
                    {MOCK_BORROW_HISTORY.map((item) => (
                      <tr key={item.id} className="hover:bg-slate-50/60 transition">
                        <td className="p-4">
                          <p className="font-bold text-slate-800 text-sm">{item.title}</p>
                          <p className="text-[11px] text-slate-400 mt-0.5">{item.author}</p>
                        </td>
                        <td className="p-4 font-medium text-slate-600">{item.borrowDate}</td>
                        <td className="p-4">
                          <p className={`font-semibold ${item.isOverdue ? 'text-red-600' : 'text-slate-700'}`}>
                            {item.dueDate}
                          </p>
                          {item.isOverdue && <span className="text-[10px] text-red-500 font-bold block">Quá hạn</span>}
                        </td>
                        <td className="p-4 text-center font-bold text-[#005f60] text-sm">
                          {item.renewCount}
                        </td>
                        <td className="p-4">
                          <span className={`inline-flex items-center gap-1 px-3 py-1 rounded-full text-[11px] font-bold ${
                            item.isOverdue 
                              ? 'bg-red-100 text-red-700' 
                              : item.status === 'Đã trả' 
                              ? 'bg-slate-100 text-slate-500' 
                              : 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                          }`}>
                            • {item.status}
                          </span>
                        </td>
                        <td className="p-4 text-right">
                          {item.canRenew ? (
                            <button 
                              onClick={() => alert(`Gia hạn thành công cuốn: ${item.title}`)}
                              className="bg-[#005f60] hover:bg-[#004b4c] text-white px-3.5 py-1.5 rounded-lg text-xs font-bold transition shadow-sm"
                            >
                              Gia hạn
                            </button>
                          ) : (
                            item.status === 'Trả trễ' ? (
                              <button disabled className="bg-slate-100 text-slate-400 px-3.5 py-1.5 rounded-lg text-xs font-semibold cursor-not-allowed">
                                Gia hạn
                              </button>
                            ) : null
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

          </div>
        )}

      </main>

      {/* 
          3. MODAL POPUP THẺ BẠN ĐỌC ĐIỆN TỬ 
      */}
      {showQRModal && (
        <div className="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl">
            <div className="bg-[#005f60] text-white p-6 text-center space-y-1">
              <p className="text-[10px] font-bold tracking-widest uppercase opacity-80">
                TRƯỜNG ĐẠI HỌC GIAO THÔNG VẬN TẢI TP.HCM
              </p>
              <h3 className="font-extrabold text-lg tracking-wide">THẺ BẠN ĐỌC ĐIỆN TỬ</h3>
            </div>

            <div className="p-6 text-center space-y-5">
              <div className="w-52 h-52 mx-auto border-2 border-[#005f60] rounded-2xl p-3 bg-white shadow-inner flex items-center justify-center">
                <img 
                  src={`https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${userProfile.code}`} 
                  alt="QR Thẻ bạn đọc" 
                  className="w-full h-full object-contain"
                />
              </div>

              <div>
                <h4 className="font-extrabold text-slate-800 text-lg">{userProfile.name}</h4>
                <p className="text-xs text-slate-500 font-medium mt-0.5">{userProfile.role}</p>
              </div>

              <div className="bg-slate-50 border border-slate-100 rounded-xl p-4 text-left space-y-2 text-xs font-medium text-slate-600">
                <div className="flex justify-between">
                  <span>Mã bạn đọc:</span>
                  <span className="font-bold text-slate-800">{userProfile.code}</span>
                </div>
                <div className="flex justify-between">
                  <span>Ngày cấp thẻ:</span>
                  <span className="font-semibold text-slate-700">{userProfile.issueDate}</span>
                </div>
                <div className="flex justify-between">
                  <span>Hạn sử dụng:</span>
                  <span className="font-bold text-amber-600">{userProfile.expiryDate}</span>
                </div>
              </div>

              <p className="text-[11px] text-slate-400 font-medium">
                Xuất trình mã QR này tại quầy thư viện để mượn / trả sách
              </p>

              <button 
                onClick={() => setShowQRModal(false)}
                className="w-full bg-[#005f60] hover:bg-[#004b4c] text-white py-3 rounded-xl font-bold text-xs transition shadow-md"
              >
                Đóng
              </button>
            </div>
          </div>
        </div>
      )}

      {/* */}
      {showReserveSuccessModal && selectedBook && (
        <div className="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl">
            <div className="bg-[#005f60] text-white p-6 text-center space-y-2">
              <div className="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center mx-auto text-2xl font-bold border border-white/20">
                ✓
              </div>
              <h3 className="font-extrabold text-xl">Đặt chỗ thành công!</h3>
              <p className="text-xs text-teal-100">Sách đã được giữ chỗ cho bạn</p>
            </div>

            <div className="p-6 text-center space-y-5">
              <div className="w-48 h-48 mx-auto border border-slate-200 rounded-2xl p-2 bg-white shadow-sm">
                <img 
                  src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=UTH-B001-B6E2NA" 
                  alt="QR Biên nhận" 
                  className="w-full h-full object-contain"
                />
              </div>
              <p className="text-xs font-semibold text-slate-500">
                QR biên nhận số <strong className="text-[#005f60] font-bold">UTH-B001-B6E2NA</strong>
              </p>

              <div className="bg-amber-50 border border-amber-200 rounded-2xl p-3.5 text-left flex items-start gap-3 text-xs text-amber-900">
                <span className="text-xl">⏰</span>
                <div>
                  <p className="font-bold text-amber-900">Thời hạn giữ chỗ: 24 giờ</p>
                  <p className="text-[11px] text-amber-700 mt-0.5">
                    Vui lòng đến lấy sách trước <strong>14:02 28/08/2026</strong>
                  </p>
                </div>
              </div>

              <div className="text-left text-xs space-y-2 bg-slate-50 p-4 rounded-xl border border-slate-100 text-slate-600">
                <p className="font-bold text-slate-800 mb-1">Hướng dẫn lấy sách:</p>
                <div className="flex items-start gap-2">
                  <span className="w-4 h-4 rounded-full bg-[#005f60] text-white flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">1</span>
                  <span>Mang thẻ sinh viên / thẻ thư viện đến quầy tiếp nhận</span>
                </div>
                <div className="flex items-start gap-2">
                  <span className="w-4 h-4 rounded-full bg-[#005f60] text-white flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">2</span>
                  <span>Yêu cầu nhân viên lấy sách tại <strong>{selectedBook.location.room} — {selectedBook.location.level}</strong></span>
                </div>
                <div className="flex items-start gap-2">
                  <span className="w-4 h-4 rounded-full bg-[#005f60] text-white flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">3</span>
                  <span>Quét mã QR hoặc đọc mã biên nhận cho nhân viên</span>
                </div>
              </div>

              <button 
                onClick={() => setShowReserveSuccessModal(false)}
                className="w-full bg-[#005f60] hover:bg-[#004b4c] text-white py-3 rounded-xl font-bold text-xs transition shadow-md"
              >
                Đã hiểu, đóng lại
              </button>
            </div>
          </div>
        </div>
      )}

      {/*  */}
      {showRegisterModal && (
        <RegisterModalForm 
          onClose={() => setShowRegisterModal(false)} 
          onSwitchToLogin={() => { setShowRegisterModal(false); setShowLoginModal(true); }}
        />
      )}

      {/* */}
      {showLoginModal && (
        <div className="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-3xl max-w-sm w-full p-6 space-y-5 shadow-2xl">
            <h3 className="text-xl font-bold text-slate-800 text-center">Đăng nhập tài khoản</h3>
            <div className="space-y-3">
              <div>
                <label className="block text-xs font-semibold text-slate-600 mb-1">Tên đăng nhập / Mã bạn đọc</label>
                <input type="text" placeholder="UTH2024-08342" className="w-full border border-slate-300 rounded-xl p-2.5 text-xs" />
              </div>
              <div>
                <label className="block text-xs font-semibold text-slate-600 mb-1">Mật khẩu</label>
                <input type="password" placeholder="••••••••" className="w-full border border-slate-300 rounded-xl p-2.5 text-xs" />
              </div>
            </div>
            <button 
              onClick={() => { setIsLoggedIn(true); setShowLoginModal(false); }}
              className="w-full bg-[#005f60] hover:bg-[#004b4c] text-white py-3 rounded-xl text-xs font-bold transition shadow-md"
            >
              Đăng nhập
            </button>
            <div className="text-center text-xs text-slate-500">
              Chưa có tài khoản?{' '}
              <button 
                onClick={() => { setShowLoginModal(false); setShowRegisterModal(true); }}
                className="text-[#005f60] font-bold hover:underline"
              >
                Đăng ký ngay
              </button>
            </div>
          </div>
        </div>
      )}

      {/* FOOTER */}
      <footer className="bg-slate-900 text-slate-400 text-xs py-8 border-t border-slate-800 mt-12">
        <div className="max-w-7xl mx-auto px-4 text-center space-y-2">
          <p className="font-semibold text-slate-300">THƯ VIỆN TRƯỜNG ĐẠI HỌC GIAO THÔNG VẬN TẢI TP.HCM</p>
          <p>Địa chỉ: Số 2, Đường Võ Oanh, Phường 25, Quận Bình Thạnh, TP. Hồ Chí Minh</p>
          <p className="text-slate-600">© 2026 UTH Library Portal. All rights reserved.</p>
        </div>
      </footer>
    </div>
  );
}


function RegisterModalForm({ onClose, onSwitchToLogin }: { onClose: () => void; onSwitchToLogin: () => void }) {
  const [step, setStep] = useState<1 | 2>(1);
  const [formData, setFormData] = useState({
    fullName: '',
    dob: '',
    gender: '',
    phone: '',
    email: '',
    idCard: '',
    address: '',
    password: '',
    confirmPassword: '',
    captcha: ''
  });

  return (
    <div className="fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-50 overflow-y-auto">
      <div className="bg-white rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl my-8 relative">
        <button 
          onClick={onClose} 
          className="absolute top-5 right-5 text-slate-400 hover:text-slate-600 font-bold text-lg"
        >
          ✕
        </button>

        <h2 className="text-2xl font-bold text-center text-slate-800">Đăng ký tài khoản bạn đọc</h2>
        <p className="text-center text-xs text-slate-500 mt-1 mb-6">Thư viện Trường Đại học GTVT TP.HCM</p>

        {/* Indicator 2 bước */}
        <div className="flex items-center justify-center gap-3 mb-8">
          <span className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold transition ${
            step === 1 ? 'bg-[#005f60] text-white shadow-md' : 'bg-[#005f60] text-white'
          }`}>
            1
          </span>
          <div className={`w-12 h-0.5 transition ${step === 2 ? 'bg-[#005f60]' : 'bg-slate-200'}`} />
          <span className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold transition ${
            step === 2 ? 'bg-[#005f60] text-white shadow-md' : 'bg-slate-100 text-slate-400'
          }`}>
            2
          </span>
        </div>

        {/* BƯỚC 1: THÔNG TIN CÁ NHÂN (ẢNH 1) */}
        {step === 1 ? (
          <div className="space-y-4">
            <h3 className="font-bold text-slate-700 text-sm border-b border-slate-100 pb-2">Thông tin cá nhân</h3>
            
            <div>
              <label className="block text-xs font-semibold text-slate-600 mb-1">Họ và tên *</label>
              <input 
                type="text" 
                placeholder="Nguyễn Văn An" 
                className="w-full border border-slate-300 rounded-xl p-2.5 text-xs focus:ring-2 focus:ring-[#005f60] focus:outline-none"
                value={formData.fullName}
                onChange={(e) => setFormData({...formData, fullName: e.target.value})}
              />
            </div>

            <div className="grid grid-cols-2 gap-3">
              <div>
                <label className="block text-xs font-semibold text-slate-600 mb-1">Ngày sinh *</label>
                <input 
                  type="date" 
                  className="w-full border border-slate-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  value={formData.dob}
                  onChange={(e) => setFormData({...formData, dob: e.target.value})}
                />
              </div>
              <div>
                <label className="block text-xs font-semibold text-slate-600 mb-1">Giới tính *</label>
                <select 
                  className="w-full border border-slate-300 rounded-xl p-2.5 text-xs focus:outline-none bg-white"
                  value={formData.gender}
                  onChange={(e) => setFormData({...formData, gender: e.target.value})}
                >
                  <option value="">Chọn giới tính</option>
                  <option value="Nam">Nam</option>
                  <option value="Nữ">Nữ</option>
                </select>
              </div>
            </div>

            <div className="grid grid-cols-2 gap-3">
              <div>
                <label className="block text-xs font-semibold text-slate-600 mb-1">Số điện thoại *</label>
                <input 
                  type="text" 
                  placeholder="0901 234 567" 
                  className="w-full border border-slate-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  value={formData.phone}
                  onChange={(e) => setFormData({...formData, phone: e.target.value})}
                />
              </div>
              <div>
                <label className="block text-xs font-semibold text-slate-600 mb-1">Email *</label>
                <input 
                  type="email" 
                  placeholder="email@uth.edu.vn" 
                  className="w-full border border-slate-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  value={formData.email}
                  onChange={(e) => setFormData({...formData, email: e.target.value})}
                />
              </div>
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-600 mb-1">Số CCCD/CMND *</label>
              <input 
                type="text" 
                placeholder="012345678901" 
                className="w-full border border-slate-300 rounded-xl p-2.5 text-xs focus:outline-none"
                value={formData.idCard}
                onChange={(e) => setFormData({...formData, idCard: e.target.value})}
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-600 mb-1">Địa chỉ thường trú *</label>
              <input 
                type="text" 
                placeholder="123 Đường Lý Chính Thắng, Quận 3, TP.HCM" 
                className="w-full border border-slate-300 rounded-xl p-2.5 text-xs focus:outline-none"
                value={formData.address}
                onChange={(e) => setFormData({...formData, address: e.target.value})}
              />
            </div>

            <button 
              onClick={() => setStep(2)} 
              className="w-full bg-[#005f60] hover:bg-[#004b4c] text-white py-3 rounded-xl font-bold text-xs transition mt-4 shadow-md flex items-center justify-center gap-1"
            >
              Tiếp theo →
            </button>
          </div>
        ) : (
          /* BƯỚC 2: THIẾT LẬP TÀI KHOẢN (ẢNH 2) */
          <div className="space-y-4">
            <h3 className="font-bold text-slate-700 text-sm border-b border-slate-100 pb-2">Thiết lập tài khoản</h3>

            <div>
              <label className="block text-xs font-semibold text-slate-600 mb-1">Mật khẩu *</label>
              <input 
                type="password" 
                placeholder="Tối thiểu 8 ký tự" 
                className="w-full border border-slate-300 rounded-xl p-2.5 text-xs focus:outline-none"
                value={formData.password}
                onChange={(e) => setFormData({...formData, password: e.target.value})}
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-600 mb-1">Xác nhận mật khẩu *</label>
              <input 
                type="password" 
                placeholder="Nhập lại mật khẩu" 
                className="w-full border border-slate-300 rounded-xl p-2.5 text-xs focus:outline-none"
                value={formData.confirmPassword}
                onChange={(e) => setFormData({...formData, confirmPassword: e.target.value})}
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-slate-600 mb-1">Mã xác nhận (Captcha) *</label>
              <div className="flex gap-2">
                <div className="bg-slate-100 border border-slate-300 rounded-xl px-4 flex items-center justify-center font-bold tracking-widest text-[#005f60] text-sm select-none border-dashed">
                  K 7 M 2 P
                </div>
                <input 
                  type="text" 
                  placeholder="Nhập mã" 
                  className="flex-1 border border-slate-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  value={formData.captcha}
                  onChange={(e) => setFormData({...formData, captcha: e.target.value})}
                />
              </div>
            </div>

            <div className="flex gap-3 mt-6">
              <button 
                onClick={() => setStep(1)} 
                className="flex-1 border border-slate-300 hover:bg-slate-50 text-slate-700 py-2.5 rounded-xl font-bold text-xs transition"
              >
                ← Quay lại
              </button>
              <button 
                onClick={() => { alert('Đăng ký tài khoản thành công!'); onClose(); }} 
                className="flex-1 bg-[#005f60] hover:bg-[#004b4c] text-white py-2.5 rounded-xl font-bold text-xs transition shadow-md"
              >
                Đăng ký
              </button>
            </div>
          </div>
        )}

        <div className="text-center text-xs text-slate-500 mt-6 pt-4 border-t border-slate-100">
          Đã có tài khoản?{' '}
          <button onClick={onSwitchToLogin} className="text-[#005f60] font-bold hover:underline">
            Đăng nhập
          </button>
        </div>

      </div>
    </div>
  );
}
