function OPACSearch() {
  const [query, setQuery] = useState("");
  const [filterGenre, setFilterGenre] = useState("Tất cả");
  const [filterStatus, setFilterStatus] = useState("Tất cả");
  const [reservedBooks, setReservedBooks] = useState<number[]>([]);

  const genres = ["Tất cả", "Kỹ năng sống", "Tiểu thuyết", "Giáo dục", "Lịch sử", "Văn học Việt Nam", "Công nghệ", "Kinh tế"];

  const filtered = BOOKS.filter((b) => {
    const q = query.toLowerCase();
    const matchQ = !q || b.title.toLowerCase().includes(q) || b.author.toLowerCase().includes(q) || b.genre.toLowerCase().includes(q);
    const matchG = filterGenre === "Tất cả" || b.genre === filterGenre;
    const matchS = filterStatus === "Tất cả" || (filterStatus === "Còn sách" && b.available > 0) || (filterStatus === "Hết sách" && b.available === 0);
    return matchQ && matchG && matchS;
  });

  return (
    <div>
      <div className="mb-6">
        <h1 className="text-2xl font-bold text-slate-900 mb-1">Tra Cứu Thư Mục (OPAC)</h1>
        <p className="text-slate-500 text-sm">Tìm kiếm sách theo tên, tác giả, thể loại hoặc từ khóa</p>
      </div>

      {/* Search bar */}
      <div className="card p-5 mb-5">
        <div className="flex gap-3 mb-4">
          <div className="flex-1 relative">
            <span className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </span>
            <input className="input-field pl-9" placeholder="Tìm theo tên sách, tác giả, từ khóa..." value={query} onChange={(e) => setQuery(e.target.value)} />
          </div>
          <button className="btn-primary">Tìm kiếm</button>
        </div>
        <div className="flex gap-3 flex-wrap">
          <div>
            <label className="text-xs font-semibold text-slate-500 mb-1 block">Thể loại</label>
            <select className="input-field w-auto text-sm" value={filterGenre} onChange={(e) => setFilterGenre(e.target.value)}>
              {genres.map((g) => <option key={g}>{g}</option>)}
            </select>
          </div>
          <div>
            <label className="text-xs font-semibold text-slate-500 mb-1 block">Trạng thái</label>
            <select className="input-field w-auto text-sm" value={filterStatus} onChange={(e) => setFilterStatus(e.target.value)}>
              <option>Tất cả</option>
              <option>Còn sách</option>
              <option>Hết sách</option>
            </select>
          </div>
        </div>
      </div>

      {/* Results */}
      <div className="space-y-3">
        <p className="text-sm text-slate-500 font-medium">Tìm thấy <span className="text-primary font-bold">{filtered.length}</span> kết quả</p>
        {filtered.map((book) => (
          <div key={book.id} className="card p-4 flex gap-4 items-start hover:border-blue-200 transition-colors">
            <img src={book.cover} alt={book.title} className="w-16 h-22 object-cover rounded-md flex-shrink-0 bg-slate-100" style={{ height: 90 }} />
            <div className="flex-1 min-w-0">
              <div className="flex items-start justify-between gap-3">
                <div>
                  <h3 className="font-semibold text-slate-900 text-base">{book.title}</h3>
                  <p className="text-sm text-slate-500 mt-0.5">Tác giả: <span className="text-slate-700">{book.author}</span></p>
                  <p className="text-sm text-slate-500">Thể loại: <span className="text-slate-700">{book.genre}</span> · Năm: {book.year}</p>
                </div>
                <div className="flex flex-col items-end gap-2 flex-shrink-0">
                  {book.available > 0
                    ? <span className="badge badge-green">Còn {book.available}/{book.copies} cuốn</span>
                    : <span className="badge badge-red">Hết sách</span>
                  }
                  <button
                    className={`btn-${book.available > 0 ? "primary" : "secondary"} text-xs py-1.5 px-3`}
                    disabled={reservedBooks.includes(book.id) || book.available === 0}
                    onClick={() => setReservedBooks([...reservedBooks, book.id])}
                    style={{ fontSize: 13, padding: "6px 14px" }}
                  >
                    {reservedBooks.includes(book.id) ? "✓ Đã đặt giữ" : book.available > 0 ? "Đặt giữ chỗ" : "Hết sách"}
                  </button>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

function AuthForm({ view, setView }: { view: PortalView; setView: (v: PortalView) => void }) {
  const [form, setForm] = useState({ email: "", password: "", name: "", phone: "" });
  const [success, setSuccess] = useState(false);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (view === "login") setView("profile");
    else setSuccess(true);
  };

  if (success && view !== "login") {
    return (
      <div className="max-w-md mx-auto mt-10 card p-8 text-center">
        <div className="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" strokeWidth="2.5"><path d="M20 6L9 17l-5-5"/></svg>
        </div>
        <h2 className="text-xl font-bold text-slate-900 mb-2">
          {view === "register" ? "Đăng ký thành công!" : "Email đã được gửi!"}
        </h2>
        <p className="text-slate-500 text-sm mb-6">
          {view === "register" ? "Tài khoản của bạn đang chờ phê duyệt từ thư viện." : "Vui lòng kiểm tra hộp thư để đặt lại mật khẩu."}
        </p>
        <button className="btn-primary w-full justify-center" onClick={() => { setSuccess(false); setView("login"); }}>Về trang Đăng nhập</button>
      </div>
    );
  }

  return (
    <div className="max-w-md mx-auto mt-8">
      <div className="card p-8">
        <div className="flex items-center gap-3 mb-6">
          <div className="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div>
            <h2 className="text-xl font-bold text-slate-900">
              {view === "login" ? "Đăng nhập" : view === "register" ? "Đăng ký tài khoản" : "Khôi phục mật khẩu"}
            </h2>
            <p className="text-slate-500 text-xs">Hệ thống Quản lý Thư viện</p>
          </div>
        </div>

        <form onSubmit={handleSubmit} className="space-y-4">
          {view === "register" && (
            <>
              <div>
                <label className="block text-sm font-medium text-slate-700 mb-1.5">Họ và tên</label>
                <input className="input-field" placeholder="Nguyễn Văn A" value={form.name} onChange={(e) => setForm({ ...form, name: e.target.value })} required />
              </div>
              <div>
                <label className="block text-sm font-medium text-slate-700 mb-1.5">Số điện thoại</label>
                <input className="input-field" placeholder="0901 234 567" value={form.phone} onChange={(e) => setForm({ ...form, phone: e.target.value })} required />
              </div>
            </>
          )}
          <div>
            <label className="block text-sm font-medium text-slate-700 mb-1.5">Email</label>
            <input className="input-field" type="email" placeholder="email@example.com" value={form.email} onChange={(e) => setForm({ ...form, email: e.target.value })} required />
          </div>
          {view !== "forgot" && (
            <div>
              <label className="block text-sm font-medium text-slate-700 mb-1.5">Mật khẩu</label>
              <input className="input-field" type="password" placeholder="••••••••" value={form.password} onChange={(e) => setForm({ ...form, password: e.target.value })} required />
            </div>
          )}
          {view === "login" && (
            <div className="text-right">
              <button type="button" className="text-sm text-blue-600 font-medium hover:underline" onClick={() => setView("forgot")}>Quên mật khẩu?</button>
            </div>
          )}
          <button type="submit" className="btn-primary w-full justify-center mt-2" style={{ padding: "12px 20px" }}>
            {view === "login" ? "Đăng nhập" : view === "register" ? "Tạo tài khoản" : "Gửi email khôi phục"}
          </button>
        </form>

        <div className="mt-5 text-center text-sm">
          {view === "login" ? (
            <span className="text-slate-500">Chưa có tài khoản? <button className="text-blue-600 font-semibold hover:underline" onClick={() => setView("register")}>Đăng ký ngay</button></span>
          ) : (
            <span className="text-slate-500">Đã có tài khoản? <button className="text-blue-600 font-semibold hover:underline" onClick={() => setView("login")}>Đăng nhập</button></span>
          )}
        </div>
      </div>
    </div>
  );
}

