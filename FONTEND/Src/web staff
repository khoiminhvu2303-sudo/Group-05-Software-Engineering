          <button className="btn-primary flex-shrink-0" onClick={() => code && setFound(true)}>Tra cứu</button>
        </div>
        {found && !renewed && (
          <div className="space-y-3">
            <div className="bg-slate-50 rounded-lg p-4">
              <p className="text-xs text-slate-500 mb-2">Phiếu mượn cần gia hạn</p>
              <p className="font-bold text-slate-900">Atomic Habits — James Clear</p>
              <p className="text-sm text-slate-600">Độc giả: Nguyễn Thị An · DR-2024-0142</p>
              <div className="flex gap-4 mt-2">
                <div>
                  <p className="text-xs text-slate-500">Hạn trả hiện tại</p>
                  <p className="font-semibold text-amber-600">04/09/2026</p>
                </div>
                <div>
                  <p className="text-xs text-slate-500">Hạn mới sau gia hạn</p>
                  <p className="font-semibold text-green-600">24/09/2026</p>
                </div>
              </div>
            </div>
            <button className="btn-primary w-full justify-center" onClick={() => setRenewed(true)}>Xác nhận gia hạn thêm 20 ngày</button>
          </div>
        )}
        {renewed && (
          <div className="flex items-center gap-3 p-4 bg-green-50 border border-green-200 rounded-lg">
            <span className="text-2xl">✅</span>
            <div>
              <p className="font-bold text-green-800">Gia hạn thành công!</p>
              <p className="text-green-600 text-sm">Hạn trả mới: 24/09/2026</p>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

