function BookCatalog() {
  const [books, setBooks] = useState(SAMPLE_BOOKS_CATALOG);
  const [showAdd, setShowAdd] = useState(false);
  const [newBook, setNewBook] = useState({ title: "", author: "", genre: "", copies: "", isbn: "" });

  const handleAdd = () => {
    if (newBook.title) {
      setBooks([...books, { id: `SKU00${books.length + 1}`, ...newBook, copies: parseInt(newBook.copies) || 1, available: parseInt(newBook.copies) || 1 }]);
      setShowAdd(false);
      setNewBook({ title: "", author: "", genre: "", copies: "", isbn: "" });
    }
  };

  return (
    <div>
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-2xl font-bold text-slate-900 mb-1">Quản Lý Danh Mục Sách</h1>
          <p className="text-slate-500 text-sm">Thêm, sửa, xóa thông tin sách trong kho</p>
        </div>
        <button className="btn-primary" onClick={() => setShowAdd(true)}>+ Thêm sách mới</button>
      </div>

      {showAdd && (
        <div className="card p-5 mb-5 border-blue-200 ring-2 ring-blue-100">
          <h3 className="font-bold text-slate-800 mb-4">Thêm sách mới</h3>
          <div className="grid grid-cols-2 gap-3">
            {[["Tên sách", "title", "Nhập tên sách..."], ["Tác giả", "author", "Tên tác giả..."], ["Thể loại", "genre", "Kỹ năng sống, Tiểu thuyết..."], ["ISBN", "isbn", "978-..."], ["Số lượng", "copies", "0"]].map(([l, k, ph]) => (
              <div key={k}>
                <label className="block text-xs font-semibold text-slate-600 mb-1">{l}</label>
                <input className="input-field" placeholder={ph} value={newBook[k as keyof typeof newBook]} onChange={(e) => setNewBook({ ...newBook, [k]: e.target.value })} />
              </div>
            ))}
          </div>
          <div className="flex gap-2 mt-4">
            <button className="btn-primary" onClick={handleAdd}>Lưu sách</button>
            <button className="btn-secondary" onClick={() => setShowAdd(false)}>Hủy</button>
          </div>
        </div>
      )}

      <div className="card overflow-hidden">
        <table>
          <thead>
            <tr><th>Mã sách</th><th>Tên sách</th><th>Tác giả</th><th>Thể loại</th><th>ISBN</th><th>Tổng / Còn</th><th>Trạng thái</th><th>Hành động</th></tr>
          </thead>
          <tbody>
            {books.map((book) => (
              <tr key={book.id}>
                <td className="font-mono text-xs text-blue-600">{book.id}</td>
                <td className="font-semibold">{book.title}</td>
                <td>{book.author}</td>
                <td><span className="badge badge-blue">{book.genre}</span></td>
                <td className="font-mono text-xs text-slate-500">{book.isbn}</td>
                <td>{book.copies}/{book.available}</td>
                <td>{book.available > 0 ? <span className="badge badge-green">Còn sách</span> : <span className="badge badge-red">Hết sách</span>}</td>
                <td>
                  <div className="flex gap-1">
                    <button className="btn-secondary" style={{ fontSize: 12, padding: "4px 10px" }}>Sửa</button>
                    <button className="btn-danger" style={{ fontSize: 12, padding: "4px 10px" }} onClick={() => setBooks(books.filter(b => b.id !== book.id))}>Xóa</button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}

function ApproveCards() {
  const [requests, setRequests] = useState(REGISTER_REQUESTS);

  const handleApprove = (id: string) => {
    setRequests(requests.map(r => r.id === id ? { ...r, status: "Đã duyệt" } : r));
  };
  const handleReject = (id: string) => {
    setRequests(requests.map(r => r.id === id ? { ...r, status: "Từ chối" } : r));
  };

  return (
    <div>
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-2xl font-bold text-slate-900 mb-1">Phê Duyệt Cấp Thẻ Độc Giả</h1>
          <p className="text-slate-500 text-sm">Xem xét và phê duyệt yêu cầu đăng ký thẻ mới</p>
        </div>
        <div className="flex gap-2">
          <div className="bg-amber-50 border border-amber-200 rounded-lg px-4 py-2 text-center">
            <p className="text-xl font-bold text-amber-600">{requests.filter(r => r.status === "Chờ duyệt").length}</p>
            <p className="text-xs text-amber-500">Chờ duyệt</p>
          </div>
        </div>
      </div>

      <div className="card overflow-hidden">
        <table>
          <thead>
            <tr><th>Mã yêu cầu</th><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>CCCD</th><th>Ngày nộp</th><th>Trạng thái</th><th>Hành động</th></tr>
          </thead>
          <tbody>
            {requests.map((req) => (
              <tr key={req.id}>
                <td className="font-mono text-xs text-blue-600">{req.id}</td>
                <td className="font-semibold">{req.name}</td>
                <td className="text-slate-500 text-sm">{req.email}</td>
                <td>{req.phone}</td>
                <td className="font-mono text-xs">{req.cccd}</td>
                <td>{req.submittedDate}</td>
                <td>
                  <span className={`badge ${req.status === "Đã duyệt" ? "badge-green" : req.status === "Từ chối" ? "badge-red" : "badge-amber"}`}>{req.status}</span>
                </td>
                <td>
                  {req.status === "Chờ duyệt" && (
                    <div className="flex gap-1">
                      <button className="btn-success" style={{ fontSize: 12, padding: "5px 10px" }} onClick={() => handleApprove(req.id)}>✓ Duyệt</button>
                      <button className="btn-danger" style={{ fontSize: 12, padding: "5px 10px" }} onClick={() => handleReject(req.id)}>✗ Từ chối</button>
                    </div>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}

