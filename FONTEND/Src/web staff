function BorrowProcess() {
  const [step, setStep] = useState(1);
  const [readerCard, setReaderCard] = useState("");
  const [bookCode, setBookCode] = useState("");
  const [readerVerified, setReaderVerified] = useState(false);
  const [bookScanned, setBookScanned] = useState(false);
  const [printed, setPrinted] = useState(false);

  const handleVerifyReader = () => {
    if (readerCard) setReaderVerified(true);
  };
  const handleScanBook = () => {
    if (bookCode) setBookScanned(true);
  };
  const handlePrint = () => { setPrinted(true); };

  return (
    <div>
      <h1 className="text-2xl font-bold text-slate-900 mb-1">Lập Phiếu Mượn Sách</h1>
      <p className="text-slate-500 text-sm mb-6">Quét thẻ độc giả và mã vạch sách để xử lý mượn</p>

      {/* Steps indicator */}
      <div className="flex items-center gap-3 mb-7">
        {["Xác thực thẻ", "Quét sách", "Xác nhận & In"].map((s, i) => (
          <div key={i} className="flex items-center gap-2">
            <div className={`w-7 h-7 rounded-full flex items-center justify-center text-sm font-bold ${step > i + 1 ? "bg-green-500 text-white" : step === i + 1 ? "bg-blue-600 text-white" : "bg-slate-200 text-slate-500"}`}>
              {step > i + 1 ? "✓" : i + 1}
            </div>
            <span className={`text-sm font-medium ${step === i + 1 ? "text-blue-700" : "text-slate-400"}`}>{s}</span>
            {i < 2 && <div className={`h-px w-12 ${step > i + 1 ? "bg-green-400" : "bg-slate-200"}`} />}
          </div>
        ))}
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-5">
        {/* Step 1: Reader card */}
        <div className={`card p-5 ${step === 1 ? "border-blue-300 ring-2 ring-blue-100" : ""}`}>
          <div className="flex items-center gap-2 mb-4">
            <div className={`w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold ${readerVerified ? "bg-green-500 text-white" : "bg-blue-600 text-white"}`}>
              {readerVerified ? "✓" : "1"}
            </div>
            <h3 className="font-bold text-slate-800">Xác thực thẻ độc giả</h3>
          </div>
          <div className="flex gap-2 mb-3">
            <input className="input-field" placeholder="Quét hoặc nhập mã thẻ độc giả..." value={readerCard} onChange={(e) => setReaderCard(e.target.value)} />
            <button className="btn-primary flex-shrink-0" onClick={handleVerifyReader}>Xác thực</button>
          </div>
          {readerVerified && (
            <div className="bg-green-50 border border-green-200 rounded-lg p-3">
              <p className="text-xs text-green-600 font-semibold mb-1">✓ Độc giả hợp lệ</p>
              <p className="text-sm font-bold text-slate-900">Nguyễn Thị An</p>
              <p className="text-xs text-slate-500">DR-2024-0142 · Thẻ còn hạn đến 01/01/2026</p>
              <p className="text-xs text-slate-500">Đang mượn: 2/5 cuốn · Không có phiếu phạt</p>
            </div>
          )}
        </div>

        {/* Step 2: Book scan */}
        <div className={`card p-5 ${step === 2 ? "border-blue-300 ring-2 ring-blue-100" : ""}`}>
          <div className="flex items-center gap-2 mb-4">
            <div className={`w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold ${bookScanned ? "bg-green-500 text-white" : step >= 2 ? "bg-blue-600 text-white" : "bg-slate-200 text-slate-400"}`}>
              {bookScanned ? "✓" : "2"}
            </div>
            <h3 className="font-bold text-slate-800">Quét mã vạch sách</h3>
          </div>
          <div className="flex gap-2 mb-3">
            <input className="input-field" placeholder="Quét mã vạch sách..." value={bookCode} onChange={(e) => setBookCode(e.target.value)} disabled={!readerVerified} />
            <button className="btn-primary flex-shrink-0" onClick={handleScanBook} disabled={!readerVerified}>Thêm</button>
          </div>
          {bookScanned && (
            <div className="bg-blue-50 border border-blue-200 rounded-lg p-3">
              <p className="text-xs text-blue-600 font-semibold mb-1">📚 Sách đã quét</p>
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm font-bold text-slate-900">Đắc Nhân Tâm</p>
                  <p className="text-xs text-slate-500">Dale Carnegie · Mã: SKU001-02</p>
                </div>
                <span className="badge badge-green">Có sẵn</span>
              </div>
            </div>
          )}
        </div>
      </div>

      {/* Borrow summary & confirm */}
      {bookScanned && readerVerified && (
        <div className="card p-5 mt-5">
          <h3 className="font-bold text-slate-800 mb-4">Xác nhận phiếu mượn</h3>
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-5">
            {[
              ["Độc giả", "Nguyễn Thị An"],
              ["Mã thẻ", "DR-2024-0142"],
              ["Ngày mượn", new Date().toLocaleDateString("vi-VN")],
              ["Hạn trả", "15/09/2026"],
            ].map(([l, v]) => (
              <div key={l} className="bg-slate-50 rounded-lg p-3">
                <p className="text-xs text-slate-500 mb-0.5">{l}</p>
                <p className="text-sm font-bold text-slate-900">{v}</p>
              </div>
            ))}
          </div>
          <div className="bg-slate-50 rounded-lg p-4 mb-4">
            <div className="flex items-center justify-between text-sm">
              <span className="text-slate-600">Đắc Nhân Tâm — Dale Carnegie</span>
              <span className="text-slate-500">SKU001-02</span>
            </div>
          </div>
          {!printed ? (
            <div className="flex gap-3">
              <button className="btn-primary" onClick={() => { setPrinted(true); }}>
                🖨️ Xác nhận & In biên nhận
              </button>
              <button className="btn-secondary" onClick={() => { setStep(1); setReaderVerified(false); setBookScanned(false); setReaderCard(""); setBookCode(""); setPrinted(false); }}>
                Hủy bỏ
              </button>
            </div>
          ) : (
            <div className="flex items-center gap-3 p-4 bg-green-50 border border-green-200 rounded-lg">
              <div className="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" strokeWidth="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </div>
              <div>
                <p className="font-bold text-green-800">Phiếu mượn đã được tạo thành công!</p>
                <p className="text-green-600 text-sm">Biên nhận đã được in · Mã phiếu: PM{Date.now().toString().slice(-5)}</p>
              </div>
              <button className="ml-auto btn-secondary" onClick={() => { setStep(1); setReaderVerified(false); setBookScanned(false); setReaderCard(""); setBookCode(""); setPrinted(false); }}>
                Phiếu mới
              </button>
            </div>
          )}
        </div>
      )}
    </div>
  );
}

function ReturnProcess() {
  const [returnCode, setReturnCode] = useState("");
  const [returned, setReturned] = useState<typeof OVERDUE_BORROWS>([]);
  const [fineCreated, setFineCreated] = useState<string[]>([]);

  const handleReturn = (item: typeof OVERDUE_BORROWS[0]) => {
    setReturned([...returned, item]);
  };
  const handleCreateFine = (id: string) => {
    setFineCreated([...fineCreated, id]);
  };

  return (
    <div>
      <h1 className="text-2xl font-bold text-slate-900 mb-1">Nhận Trả Sách</h1>
      <p className="text-slate-500 text-sm mb-6">Xử lý trả sách, kiểm tra tình trạng và tạo phiếu phạt nếu cần</p>

      <div className="card p-5 mb-5">
        <div className="flex gap-3">
          <input className="input-field" placeholder="Nhập mã phiếu mượn hoặc mã vạch sách..." value={returnCode} onChange={(e) => setReturnCode(e.target.value)} />
          <button className="btn-primary flex-shrink-0">Tra cứu</button>
        </div>
      </div>

      {/* Overdue list for demo */}
      <div className="mb-5">
        <h3 className="font-bold text-slate-700 mb-3 text-sm">Sách quá hạn cần xử lý ({OVERDUE_BORROWS.length})</h3>
        <div className="space-y-3">
          {OVERDUE_BORROWS.map((item) => {
            const isReturned = returned.find((r) => r.id === item.id);
            const hasFine = fineCreated.includes(item.id);
            const fine = item.daysLate * 2000;
            return (
              <div key={item.id} className={`card p-4 ${isReturned ? "opacity-60" : ""}`}>
                <div className="flex items-start justify-between gap-4">
                  <div className="flex-1">
                    <div className="flex items-center gap-2 mb-1">
                      <span className="font-mono text-xs text-blue-600">{item.id}</span>
                      <span className="badge badge-red">Quá hạn {item.daysLate} ngày</span>
                      <span className={`badge ${item.condition === "Tốt" ? "badge-green" : "badge-amber"}`}>{item.condition}</span>
                    </div>
                    <h3 className="font-semibold text-slate-900">{item.title}</h3>
                    <p className="text-sm text-slate-500">Độc giả: <span className="text-slate-700">{item.reader}</span> · {item.readerCode}</p>
                    <p className="text-sm text-slate-500">Hạn trả: {item.dueDate} · Tiền phạt dự kiến: <span className="font-bold text-red-600">{fine.toLocaleString()}đ</span></p>
                  </div>
                  <div className="flex flex-col gap-2 flex-shrink-0">
                    {!isReturned ? (
                      <button className="btn-primary" style={{ fontSize: 13, padding: "7px 14px" }} onClick={() => handleReturn(item)}>
                        ✓ Nhận trả sách
                      </button>
                    ) : (
                      <span className="badge badge-green">Đã nhận trả</span>
                    )}
                    {isReturned && !hasFine && (
                      <button className="btn-danger" style={{ fontSize: 13, padding: "7px 14px" }} onClick={() => handleCreateFine(item.id)}>
                        📋 Tạo phiếu phạt
                      </button>
                    )}
                    {hasFine && <span className="badge badge-red">Phiếu phạt đã tạo</span>}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}

